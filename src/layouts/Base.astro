---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  path?: string; // 'ru' | 'en'
  ogImage?: string; // e.g. '/images/og-ru.jpg'
  keywords?: string;
}
const {
  title = 'Лендинг-завод — Chipsa',
  description = 'Настроим под ваш бренд систему производства лендингов. Дальше ваша команда делает их сама.',
  lang = 'ru',
  path = 'ru',
  ogImage = '/images/og-ru.jpg',
  keywords = '',
} = Astro.props;

const site = (Astro.site?.href || 'https://lpfactory.chipsa.dev/').replace(/\/$/, '');
const canonical = `${site}/${path}`;
const ogImageUrl = `${site}${ogImage}`;
const ogLocale = lang === 'en' ? 'en_US' : 'ru_RU';
const altLocale = lang === 'en' ? 'ru_RU' : 'en_US';

const cookie =
  lang === 'en'
    ? { text: 'We use cookies and Yandex Metrica to improve the site.', more: 'Privacy Policy', accept: 'Accept', href: '/legal/privacy-policy-en.pdf' }
    : { text: 'Мы используем cookie и Яндекс.Метрику, чтобы делать сайт лучше.', more: 'Политика конфиденциальности', accept: 'Принять', href: '/legal/privacy-policy-ru.pdf' };

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Chipsa — LP Factory',
  url: canonical,
  logo: `${site}/images/logo-chipsa.png`,
  image: ogImageUrl,
  description,
  inLanguage: lang,
  sameAs: ['https://chipsa.design', 'https://igaming.chipsa.design', 'https://t.me/maxkysh'],
  areaServed: 'Worldwide',
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: lang === 'en' ? 'Landing-page design system setup' : 'Настройка системы производства лендингов',
      description,
    },
  },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Chipsa Design Studio" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0a1113" />
    <meta name="yandex-verification" content="dc662cebe590e57b" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={`${site}/ru`} />
    <link rel="alternate" hreflang="en" href={`${site}/en`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/ru`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chipsa — LP Factory" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={altLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preload" as="font" type="font/woff2" crossorigin href={lang === 'en' ? '/fonts/unbounded-700-latin.woff2' : '/fonts/unbounded-700-cyrillic.woff2'} />

    <!-- Yandex.Metrika counter -->
    <script is:inline type="text/javascript">
      (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
        k = e.createElement(t), a = e.getElementsByTagName(t)[0], k.async = 1, k.src = r, a.parentNode.insertBefore(k, a);
      })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=110313193', 'ym');
      ym(110313193, 'init', { ssr: true, webvisor: true, clickmap: true, ecommerce: 'dataLayer', accurateTrackBounce: true, trackLinks: true });
    </script>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body>
    <slot />
    <noscript><div><img src="https://mc.yandex.ru/watch/110313193" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <div id="cookie-consent" class="cookie-consent" role="dialog" aria-label={cookie.accept}>
      <span class="cookie-consent__text">{cookie.text} <a href={cookie.href} target="_blank" rel="noopener">{cookie.more}</a></span>
      <button type="button" class="cookie-consent__accept" data-accept>{cookie.accept}</button>
    </div>
    <script>
      import { initReveal } from '../scripts/reveal';
      import { initInteractions } from '../scripts/interactions';
      initReveal();
      initInteractions();
    </script>
  </body>
</html>
