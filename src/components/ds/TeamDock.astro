---
/**
 * Chipsa Lander — TeamDock. A row of team avatars stacked like a fanned row of
 * coins. Entrance: each coin flips + rises in, staggered, when scrolled into
 * view. Hover: macOS-dock magnification (center-growth) + a glint sweep. The row
 * sizes its coins to span the full container width.
 *
 * Ported from the project's TeamDock.jsx to a vanilla-TS island.
 */
interface Member {
  name: string;
  src: string;
}
interface Props {
  members?: Member[];
  overlap?: number;
  boost?: number;
  radius?: number;
  maxSize?: number;
  minSize?: number;
}
const { members = [], overlap = 0.16, boost = 0.3, radius = 2.2, maxSize = 168, minSize = 30 } = Astro.props;
---
<div
  class="team-dock"
  data-overlap={overlap}
  data-boost={boost}
  data-radius={radius}
  data-maxsize={maxSize}
  data-minsize={minSize}
  style="width:100%"
>
  <div class="team-dock__row" style="display:flex;align-items:center;flex-wrap:nowrap;width:100%">
    {members.map((m, i) => (
      <span
        class="team-dock__outer"
        title={m.name}
        data-index={i}
        style="display:block;opacity:0;position:relative;perspective:600px"
      >
        <span class="team-coin team-dock__inner" style="display:block;border-radius:50%;overflow:hidden;background:var(--surface-2);box-shadow:0 0 0 3px var(--bg-page);transform:scale(1);transform-origin:center center;transition:transform .22s var(--ease-out, cubic-bezier(.22,1,.36,1));cursor:pointer;will-change:transform">
          <img src={m.src} alt={m.name} draggable="false" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block;user-select:none" />
          <span class="team-glint" aria-hidden="true"></span>
        </span>
      </span>
    ))}
  </div>
</div>

<script>
  // macOS-dock avatar row. Sizes coins to span the container, reveals on scroll,
  // magnifies (center-growth) near the cursor with smooth distance falloff.
  function initTeamDocks(): void {
    const reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('.team-dock').forEach((dock) => {
      if (dock.dataset.bound) return;
      dock.dataset.bound = '1';

      const row = dock.querySelector<HTMLElement>('.team-dock__row');
      const outers = Array.from(dock.querySelectorAll<HTMLElement>('.team-dock__outer'));
      const inners = Array.from(dock.querySelectorAll<HTMLElement>('.team-dock__inner'));
      if (!row || !outers.length) return;

      const overlap = parseFloat(dock.dataset.overlap || '0.16');
      const boost = parseFloat(dock.dataset.boost || '0.3');
      const radius = parseFloat(dock.dataset.radius || '2.2');
      const maxSize = parseFloat(dock.dataset.maxsize || '168');
      const minSize = parseFloat(dock.dataset.minsize || '30');
      const n = outers.length;

      let size = 92;
      let centers: number[] = [];

      const fit = () => {
        const w = dock.clientWidth;
        if (!w || !n) return;
        const denom = 1 + (n - 1) * (1 - overlap);
        size = Math.max(minSize, Math.min(maxSize, w / denom));
        const overlapPx = Math.round(size * overlap);
        row.style.paddingTop = `${size * 0.2}px`;
        row.style.paddingBottom = `${size * 0.2}px`;
        outers.forEach((el, i) => {
          el.style.marginLeft = i === 0 ? '0' : `-${overlapPx}px`;
          el.style.zIndex = String(n - i);
        });
        inners.forEach((el) => {
          el.style.width = `${size}px`;
          el.style.height = `${size}px`;
        });
      };

      const measure = () => {
        centers = inners.map((el) => {
          const r = el.getBoundingClientRect();
          return r.left + r.width / 2;
        });
      };

      const apply = (cursorX: number) => {
        const R = size * radius;
        inners.forEach((el, i) => {
          const c = centers[i] || 0;
          const d = Math.abs(cursorX - c);
          const t = Math.max(0, 1 - d / R);
          const ease = t * t * (3 - 2 * t); // smoothstep
          const s = 1 + boost * ease;
          el.style.transform = `scale(${s})`;
          el.style.zIndex = String(100 + Math.round(ease * 100));
        });
      };

      const reset = () => {
        inners.forEach((el, i) => {
          el.style.transform = 'scale(1)';
          el.style.zIndex = String(n - i);
        });
      };

      const onMove = (e: PointerEvent) => {
        if (reduced) return;
        if (!centers.length) measure();
        apply(e.clientX);
      };

      row.addEventListener('pointermove', onMove);
      row.addEventListener('pointerleave', reset);

      fit();
      if ('ResizeObserver' in window) {
        new ResizeObserver(() => {
          fit();
          measure();
        }).observe(dock);
      }
      window.addEventListener('resize', () => {
        fit();
        measure();
      });

      // Reveal on first scroll-in (staggered flip-rise).
      const reveal = () => {
        measure();
        outers.forEach((el, i) => {
          el.style.transition = `opacity .5s var(--ease-out, cubic-bezier(.22,1,.36,1)) ${i * 65}ms, transform .62s var(--ease-out, cubic-bezier(.22,1,.36,1)) ${i * 65}ms`;
          el.style.opacity = '1';
          el.style.transform = 'translateY(0) rotateY(0deg)';
        });
      };
      // Set the hidden start-state, then reveal when in view.
      outers.forEach((el) => {
        el.style.transform = 'translateY(26px) rotateY(-90deg)';
      });
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              reveal();
              io.disconnect();
            }
          },
          { threshold: 0.25 }
        );
        io.observe(dock);
      } else {
        reveal();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTeamDocks);
  } else {
    initTeamDocks();
  }
</script>
