---
import Base from '../layouts/Base.astro';
---
<Base lang="ru" path="ru" title="404 — страница не найдена · Chipsa" description="Страница не найдена.">
  <main style="min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:var(--gutter);position:relative;overflow:hidden">
    <div aria-hidden="true" style="position:absolute;inset:0;background:radial-gradient(120% 90% at 78% 8%, rgba(31,163,154,0.20) 0%, rgba(10,110,140,0.10) 35%, rgba(10,14,15,0) 68%)"></div>
    <div style="position:relative;text-align:center;display:flex;flex-direction:column;align-items:center;gap:var(--s-5);max-width:34ch">
      <span class="ink-grad" style="font-family:var(--font-display);font-weight:700;font-size:var(--t-mega);line-height:1;letter-spacing:var(--ls-mega)">404</span>
      <h1 style="margin:0;font-family:var(--font-display);font-weight:700;font-size:var(--t-h2);line-height:var(--lh-head);color:var(--text-strong)">Страница не найдена</h1>
      <p style="margin:0;font-size:var(--t-lead);line-height:1.4;color:var(--text-body)">Такой страницы нет. Вернитесь на главную — там всё про наш лендинг-завод. / Page not found — head back to the homepage.</p>
      <div style="display:flex;flex-wrap:wrap;gap:var(--s-4);justify-content:center;margin-top:var(--s-3)">
        <a href="/ru" style="display:inline-flex;align-items:center;gap:0.5em;padding:14px 26px;border-radius:var(--r-2);background:var(--teal-500);color:#fff;font-family:var(--font-sans);font-weight:600;text-decoration:none">На главную →</a>
        <a href="/en" style="display:inline-flex;align-items:center;gap:0.5em;padding:14px 26px;border-radius:var(--r-2);background:var(--surface-1);color:var(--text-strong);font-family:var(--font-sans);font-weight:600;text-decoration:none">English version →</a>
      </div>
    </div>
  </main>
</Base>
